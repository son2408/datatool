<Window x:Class="DataTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:DataTool.UI.Controls;assembly=DataTool.UI.Controls"
        xmlns:vm="clr-namespace:DataTool.App.ViewModels"
        xmlns:views="clr-namespace:DataTool.App.Views"
        Title="{Binding SelectedProvince.DisplayName, StringFormat='DataTool  ·  {0}', TargetNullValue=DataTool, FallbackValue=DataTool}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DT.Window}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TaskRunViewModel}">
            <views:TaskRunView />
        </DataTemplate>
    </Window.Resources>

    <Border>
        <DockPanel>
            <!-- ===== Thanh trên cùng ===== -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource DT.Brush.Surface}"
                    BorderBrush="{StaticResource DT.Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource DT.Brush.Primary}">
                            <materialDesign:PackIcon Kind="DatabaseCogOutline" Width="22" Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DataTool" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Công cụ xử lý dữ liệu" Style="{StaticResource DT.Text.Caption}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <controls:SearchPicker x:Name="ProvincePicker"
                                               Label="TỈNH ĐANG DÙNG"
                                               Icon="MapMarkerOutline"
                                               Placeholder="Chọn tỉnh"
                                               SearchHint="Tìm tỉnh..."
                                               EmptyText="Không có tỉnh nào khớp"
                                               ItemsSource="{Binding Provinces}"
                                               SelectedItem="{Binding SelectedProvince}"
                                               DisplayMemberPath="DisplayName"
                                               IsEnabled="{Binding CanChangeProvince}"
                                               ToolTip="Tỉnh sẽ dùng khi chạy tác vụ" />
                        <Button Margin="12,0,0,0"
                                Command="{Binding OpenConfigurationCommand}"
                                Style="{StaticResource DT.Button.Secondary}"
                                ToolTip="Xem, sửa cấu hình các tỉnh">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cấu hình" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <!-- ===== Thanh trạng thái ===== -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource DT.Brush.Surface}"
                    BorderBrush="{StaticResource DT.Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource DT.Text.Caption}"
                               Text="{Binding ConfigFolder, StringFormat='Thư mục cấu hình: {0}'}" />
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CircleMedium" Width="14" Height="14" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="{StaticResource DT.Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DT.Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Margin="4,0,0,0" Style="{StaticResource DT.Text.Caption}" Text="{Binding StatusMessage}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Nội dung chính ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="200" MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Menu tác vụ -->
                <Border Grid.Column="0" Background="{StaticResource DT.Brush.Surface}">
                    <DockPanel Margin="12,16,8,12">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="TÁC VỤ"
                                   Margin="8,0,0,10"
                                   Style="{StaticResource DT.Text.Overline}" />
                        <TextBox DockPanel.Dock="Top"
                                 Margin="4,0,4,10"
                                 Text="{Binding MenuFilter, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Tìm tác vụ"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify" />
                        <TreeView x:Name="MenuTree"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemsSource="{Binding Menu}"
                                  SelectedItemChanged="OnMenuSelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <Setter Property="Padding" Value="6,6" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:MenuNodeViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon x:Name="NodeIcon"
                                                                 Kind="{Binding Icon}"
                                                                 Width="18" Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource DT.Brush.TextSecondary}" />
                                        <TextBlock x:Name="NodeText"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Title}" />
                                    </StackPanel>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTask}" Value="False">
                                            <Setter TargetName="NodeText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="NodeIcon" Property="Foreground" Value="{StaticResource DT.Brush.Primary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Task.IsDangerous}" Value="True">
                                            <Setter TargetName="NodeIcon" Property="Foreground" Value="{StaticResource DT.Brush.Danger}" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="1"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource DT.Brush.Border}"
                              ResizeBehavior="PreviousAndNext" />

                <!-- Khung bên phải: tác vụ đang chọn -->
                <Grid Grid.Column="2">
                    <ContentControl Content="{Binding CurrentTask}" Focusable="False" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding CurrentTask, Converter={StaticResource InverseNullToVisibility}}">
                        <materialDesign:PackIcon Kind="GestureTapButton" Width="56" Height="56"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{StaticResource DT.Brush.Border}" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource DT.Text.SectionTitle}"
                                   Text="Chọn một tác vụ để bắt đầu" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource DT.Text.Caption}"
                                   Text="Danh sách tác vụ nằm ở menu bên trái." />
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
