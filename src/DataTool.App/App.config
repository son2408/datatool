<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cấu hình chung cho VDMSDataHelper (DataHandler đọc file này khi khởi tạo).
  Khi build, file được chép thành DataTool.exe.config cạnh DataTool.exe.

  KHÔNG ghi thông tin riêng của tỉnh ở đây. Các giá trị theo tỉnh (connection string, Solr, VDFS...)
  được lấy từ file .yml của tỉnh đang chọn và ghi đè lúc chạy (xem Vbdlis/AppConfigOverride.cs).
  Giá trị bên dưới chỉ là mặc định để DataHandler khởi tạo không lỗi.
-->
<configuration>
  <configSections>
    <sectionGroup name="vietbando.services">
      <section name="search" type="Vietbando.Search.Configuration.SearchConfigurationSection, Vietbando.Search.Configuration" />
    </sectionGroup>
  </configSections>

  <vietbando.services>
    <!-- hostServer được ghi đè bằng solr_uri của tỉnh khi tạo SolrConfig -->
    <search hostServer="http://localhost:8983/solr" maxViewableResult="1000000000" numShards="1" replicationFactor="2" maxShardsPerNode="1" rows="3000000" />
  </vietbando.services>

  <appSettings>
    <add key="AppName" value="VBDLIS" />
    <add key="EnableSolr" value="false" />
    <add key="EnableVDMSService" value="false" />
    <add key="EnableRepository" value="true" />
    <add key="RepositoryBackend" value="VDFS" /><!-- GridFS|VDFS, ghi đè bằng repository_backend -->
    <add key="VDMSDataProviderType" value="MongoDB" />
    <add key="DataProvider" value="VDMS.ContentRepository.Core.DataProvider.MongoClient.Provider" />

    <!-- VDFS: ghi đè bằng vdfs_* của tỉnh -->
    <add key="VDFS.ApiEndpoint" value="" />
    <add key="VDFS.Tag" value="lis" />
    <add key="VDFS.RabbitUri" value="" />
    <add key="VDFS.Exchange" value="vdfs" />

    <!-- Solr: SolrKey ghi đè bằng solr_key -->
    <add key="SolrKey" value="" />
    <add key="SolrIndexInterval" value="00:00:10" />
    <add key="SolarCommitWithin" value="15000" />
    <add key="SolarBuildAutoSuggest" value="false" />
    <add key="SolarOptimize" value="false" />
    <add key="SolarStore" value="true" />
    <add key="SolarIndexBatchSize" value="1000" />
    <add key="LoadSolrIndexType" value="true" />
    <add key="SolrNonFTSType" value="Keyword" />
    <add key="GrantObjectParentPathField" value="ParentPath_s" />
    <add key="GrantObjectPathField" value="Path_s" />
    <add key="SolrStoreCaseSensitive" value="false" />

    <add key="WorkflowDataProvider" value="MongoDB" />
    <add key="MongoEnableShard" value="true" />
  </appSettings>

  <connectionStrings>
    <!-- Ghi đè bằng vdms_connection_string / log_connection_string của tỉnh -->
    <add name="VDMSConnectionString" connectionString="mongodb://localhost:27017/placeholder" />
    <add name="LogConnectionString" connectionString="mongodb://localhost:27017/placeholder_log" />
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
