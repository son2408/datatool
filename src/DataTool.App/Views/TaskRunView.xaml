<UserControl x:Class="DataTool.App.Views.TaskRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:DataTool.UI.Controls;assembly=DataTool.UI.Controls">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề tác vụ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Group}" Style="{StaticResource DT.Text.Overline}" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DT.Text.PageTitle}" VerticalAlignment="Center" />
                <Border Margin="12,0,0,0"
                        Padding="8,3"
                        CornerRadius="10"
                        VerticalAlignment="Center"
                        Background="{StaticResource DT.Brush.DangerLight}"
                        Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="14" Height="14"
                                                 Foreground="{StaticResource DT.Brush.Danger}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Margin="4,0,0,0" Text="Thay đổi dữ liệu"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource DT.Brush.Danger}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       Text="{Binding Description}"
                       Style="{StaticResource DT.Text.Body}"
                       Foreground="{StaticResource DT.Brush.TextSecondary}" />
        </StackPanel>

        <!-- Khối điều khiển -->
        <Border Grid.Row="1" Margin="0,20,0,16" Style="{StaticResource DT.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sẽ chạy trên" Style="{StaticResource DT.Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- Tỉnh lấy từ MainViewModel (DataContext của cửa sổ) -->
                    <controls:EnvironmentBadge
                        Level="Default"
                        EnvironmentName="{Binding DataContext.SelectedProvince.DisplayName, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue='Chưa chọn tỉnh', FallbackValue='Chưa chọn tỉnh'}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Margin="24,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RunCommand}" MinWidth="120">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DT.Button.Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DT.Brush.Danger}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DT.Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Chạy" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="10,0,0,0"
                            MinWidth="100"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DT.Button.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Huỷ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <controls:ProgressPanel Grid.Row="1" Grid.Column="0"
                                        Margin="0,16,0,0"
                                        Value="{Binding Progress}"
                                        IsIndeterminate="{Binding IsIndeterminate}"
                                        StatusText="{Binding StatusText}"
                                        ElapsedText="{Binding ElapsedText}" />
            </Grid>
        </Border>

        <!-- Khung log -->
        <controls:LogViewer Grid.Row="2"
                            ItemsSource="{Binding Logs}"
                            EmptyText="Chưa có log. Nhấn Chạy để bắt đầu.">
            <controls:LogViewer.HeaderContent>
                <Button Command="{Binding OpenLogFolderCommand}"
                        ToolTip="Mở thư mục chứa file log"
                        Height="28" Padding="8,0" Margin="0,0,4,0"
                        Foreground="{StaticResource DT.Brush.LogMuted}"
                        Cursor="Hand"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Thư mục log" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:LogViewer.HeaderContent>
        </controls:LogViewer>
    </Grid>
</UserControl>
