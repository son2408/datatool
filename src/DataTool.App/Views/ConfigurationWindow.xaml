<Window x:Class="DataTool.App.Views.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="DataTool"
        Width="1180" Height="820"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="OnClosing"
        Style="{StaticResource DT.Window}">

    <Window.Resources>
        <Style x:Key="SectionIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource DT.Brush.Primary}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Thư mục cấu hình ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource DT.Brush.Surface}"
                BorderBrush="{StaticResource DT.Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Thư mục" Style="{StaticResource DT.Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border Background="{StaticResource DT.Brush.Background}"
                        BorderBrush="{StaticResource DT.Brush.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}"
                               FontFamily="{StaticResource DT.Font.Mono}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource DT.Brush.TextSecondary}" />
                </Border>
                <Button Margin="12,0,0,0" Command="{Binding ChangeFolderCommand}" Style="{StaticResource DT.Button.Secondary}" Height="32">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Đổi thư mục" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="10,0,0,0" Command="{Binding ReloadCommand}" Style="{StaticResource DT.Button.Secondary}" Height="32">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tải lại" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== Thanh dưới cùng ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource DT.Brush.Surface}"
                BorderBrush="{StaticResource DT.Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Bỏ thay đổi" MinWidth="110" Margin="0,0,10,0"
                            Command="{Binding DiscardCommand}"
                            Style="{StaticResource DT.Button.Secondary}" />
                    <Button MinWidth="100" Command="{Binding SaveCommand}" Style="{StaticResource DT.Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Lưu" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Selected.IsDirty, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource DT.Brush.Warning}" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" Text="Có thay đổi chưa lưu" Foreground="{StaticResource DT.Brush.Warning}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Danh sách tỉnh ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource DT.Brush.Surface}"
                    BorderBrush="{StaticResource DT.Brush.Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,12">
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding AddCommand}" ToolTip="Thêm tỉnh (tạo file .yml mới)" Style="{StaticResource DT.Button.Icon}">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding DuplicateCommand}" ToolTip="Nhân bản tỉnh đang chọn" Style="{StaticResource DT.Button.Icon}">
                                <materialDesign:PackIcon Kind="ContentDuplicate" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding DeleteCommand}" ToolTip="Xoá tỉnh đang chọn" Style="{StaticResource DT.Button.Icon}"
                                    Foreground="{StaticResource DT.Brush.Danger}">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource DT.Text.Overline}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBox DockPanel.Dock="Top"
                             Margin="4,0,4,10"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Tìm theo mã tỉnh"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify" />

                    <Grid>
                        <ListBox ItemsSource="{Binding ProvincesView}"
                                 SelectedItem="{Binding Selected}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Nút tròn: tỉnh đang dùng (chỉ một) -->
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse x:Name="Ring" Stroke="{StaticResource DT.Brush.TextSecondary}" StrokeThickness="2" />
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource DT.Brush.Success}" Visibility="Collapsed" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock x:Name="DirtyMark" Text=" •" FontWeight="Bold" FontSize="14"
                                                       Foreground="{StaticResource DT.Brush.Warning}" Visibility="Collapsed"
                                                       ToolTip="Có thay đổi chưa lưu" />
                                        </StackPanel>
                                        <Border x:Name="ActiveChip" Grid.Column="2" CornerRadius="9" Padding="7,1"
                                                Background="{StaticResource DT.Brush.Success}" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                            <TextBlock Text="ĐANG DÙNG" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DT.Brush.Success}" />
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ActiveChip" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter TargetName="DirtyMark" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Margin="8,20" TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{StaticResource DT.Text.Caption}"
                                   Text="Thư mục chưa có file .yml nào. Bấm + để thêm, hoặc Đổi thư mục."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== Chi tiết tỉnh ===== -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding Selected}"
                          Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <StackPanel Margin="28,14,28,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Mở file" Margin="0,0,10,0" Height="32"
                                ToolTip="{Binding FilePath}"
                                Style="{StaticResource DT.Button.Secondary}" />
                        <Button Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Height="32">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DT.Button.Primary}">
                                    <Setter Property="Background" Value="{StaticResource DT.Brush.Success}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DT.Brush.Success}" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Dùng cấu hình này" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="Đang dùng" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource DT.Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Margin="10,0,0,0" Text="Chung" Style="{StaticResource DT.Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="service_key" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /><Run Text="  Mã tỉnh" /></TextBlock>
                                    <TextBox Text="{Binding ServiceKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="repository_backend" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                        <ComboBox IsEditable="True"
                                                  ItemsSource="{Binding RepositoryBackendOptions}"
                                                  Text="{Binding RepositoryBackend, UpdateSourceTrigger=PropertyChanged}"
                                                  FontFamily="{StaticResource DT.Font.Mono}"
                                                  Padding="10,7" Margin="0,0,0,10"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                        <Border Style="{StaticResource DT.Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="TextBoxSearchOutline" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Margin="10,0,0,0" Text="Solr" Style="{StaticResource DT.Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="solr_uri" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding SolrUri, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="solr_key" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding SolrKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                        <Grid Grid.Column="2">
                        <Border Style="{StaticResource DT.Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Rabbit" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Margin="10,0,0,0" Text="RabbitMQ" Style="{StaticResource DT.Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="rabbit_uri" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding RabbitUri, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="repo_endpoint" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /><Run Text="  Service clients" /></TextBlock>
                                    <TextBox Text="{Binding RepoEndpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="is_new_repo" VerticalAlignment="Center" Margin="0,0,10,0"
                                               FontFamily="{StaticResource DT.Font.Mono}" FontSize="12"
                                               Foreground="{StaticResource DT.Brush.Primary}" />
                                    <ToggleButton IsChecked="{Binding IsNewRepo}" Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DT.Text.Caption}">
                                                <Setter Property="Text" Value="false" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNewRepo}" Value="True">
                                                        <Setter Property="Text" Value="true" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource DT.Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="DatabaseOutline" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Margin="10,0,0,0" Text="MongoDB" Style="{StaticResource DT.Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="vdms_connection_string" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding VdmsConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="log_connection_string" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding LogConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    <Border Style="{StaticResource DT.Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="FolderNetworkOutline" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Margin="10,0,0,0" Text="VDFS" Style="{StaticResource DT.Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="vdfs_api_endpoint" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding VdfsApiEndpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="vdfs_tag" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding VdfsTag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="vdfs_rabbit_uri" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding VdfsRabbitUri, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="vdfs_exchange" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                    <TextBox Text="{Binding VdfsExchange, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    <Grid Visibility="{Binding HasExtraFields, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource DT.Card}" Padding="18,14" Margin="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="DotsHorizontal" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Margin="10,0,0,0" Text="Khác" Style="{StaticResource DT.Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ExtraFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DT.Field.Label}"><Run Text="{Binding Key, Mode=OneWay}" FontFamily="{StaticResource DT.Font.Mono}" Foreground="{StaticResource DT.Brush.Primary}" /></TextBlock>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DT.Field.Code}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
