<UserControl x:Class="DataTool.UI.Controls.EnvironmentBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center"
             HorizontalAlignment="Left">
    <Border x:Name="LayoutRoot"
            CornerRadius="12"
            Padding="10,3,12,3"
            Background="{Binding BadgeBrush}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding EnvironmentName}"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
