<Window x:Class="DataTool.UI.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xác nhận"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DT.Window}"
        Background="{DynamicResource DT.Brush.Surface}">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <materialDesign:PackIcon x:Name="HeaderIcon"
                                     Kind="HelpCircleOutline"
                                     Width="28" Height="28"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource DT.Brush.Primary}" />
            <TextBlock x:Name="TitleText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="{DynamicResource DT.Brush.TextPrimary}" />

        <Border x:Name="RequiredPanel"
                Grid.Row="2"
                Margin="0,16,0,0"
                Padding="14,12"
                CornerRadius="6"
                Background="{DynamicResource DT.Brush.DangerLight}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DT.Brush.Danger}">
                    <Run Text="Để xác nhận, hãy gõ chính xác" />
                    <Run x:Name="RequiredRun" FontWeight="Bold" />
                    <Run Text="vào ô bên dưới." />
                </TextBlock>
                <TextBox x:Name="InputBox"
                         Margin="0,10,0,0"
                         Background="{DynamicResource DT.Brush.Surface}"
                         TextChanged="OnInputChanged"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         Padding="10,8" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,22,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    IsCancel="True"
                    MinWidth="90"
                    Margin="0,0,10,0"
                    Content="Huỷ"
                    Style="{DynamicResource DT.Button.Secondary}" />
            <Button x:Name="ConfirmButton"
                    IsDefault="True"
                    MinWidth="110"
                    Content="Đồng ý"
                    Click="OnConfirmClick"
                    Style="{DynamicResource DT.Button.Primary}" />
        </StackPanel>
    </Grid>
</Window>
