<UserControl x:Class="DataTool.UI.Controls.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border x:Name="LayoutRoot"
            CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource DT.Brush.LogBackground}">
        <DockPanel>
            <!-- Thanh tiêu đề -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource DT.Brush.LogHeader}"
                    CornerRadius="8,8,0,0"
                    Padding="14,6,6,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ContentPresenter Content="{Binding HeaderContent}" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton"
                                Click="OnCopyClick"
                                ToolTip="Sao chép log (dòng đang chọn, hoặc toàn bộ)"
                                Width="30" Height="30" Padding="4"
                                Foreground="{DynamicResource DT.Brush.LogMuted}"
                                Style="{DynamicResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="ClearButton"
                                Click="OnClearClick"
                                ToolTip="Xoá nội dung khung log"
                                Width="30" Height="30" Padding="4"
                                Foreground="{DynamicResource DT.Brush.LogMuted}"
                                Style="{DynamicResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ConsoleLine" Width="16" Height="16"
                                                 Foreground="{DynamicResource DT.Brush.LogMuted}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Header}"
                                   Foreground="{DynamicResource DT.Brush.LogText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Items.Count, ElementName=LogList, StringFormat='  ·  {0} dòng'}"
                                   Foreground="{DynamicResource DT.Brush.LogMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding ItemsSource}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,6"
                         SelectionMode="Extended"
                         FontFamily="{DynamicResource DT.Font.Mono}"
                         FontSize="12"
                         Foreground="{DynamicResource DT.Brush.LogText}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="14,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DT.Brush.LogSelection}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <!-- Mỗi dòng log cần có: Timestamp (DateTime), Level, Message -->
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                           Foreground="{DynamicResource DT.Brush.LogMuted}" />
                                <TextBlock x:Name="LevelText"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Text="{Binding Level}" />
                                <TextBlock x:Name="MessageText"
                                           Grid.Column="2"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource DT.Brush.LogSuccess}" />
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource DT.Brush.LogSuccess}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource DT.Brush.LogWarning}" />
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource DT.Brush.LogWarning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource DT.Brush.LogError}" />
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource DT.Brush.LogError}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource DT.Brush.LogMuted}" />
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource DT.Brush.LogMuted}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Hiện khi chưa có dòng log nào -->
                <TextBlock Text="{Binding EmptyText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DT.Brush.LogMuted}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=LogList}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
