<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:local="clr-namespace:DataTool.UI.Controls">

    <Style TargetType="{x:Type local:FormField}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FormField}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{TemplateBinding Label}"
                                       FontSize="12"
                                       FontFamily="{DynamicResource DT.Font.Mono}"
                                       Foreground="{DynamicResource DT.Brush.Primary}" />
                            <TextBlock x:Name="HintText"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       Text="{TemplateBinding Hint}"
                                       Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                        </StackPanel>
                        <TextBox x:Name="PART_TextBox"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 FontFamily="{DynamicResource DT.Font.Mono}"
                                 FontSize="13"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UseMonospace" Value="False">
                            <Setter TargetName="PART_TextBox" Property="FontFamily" Value="{DynamicResource DT.Font.Ui}" />
                        </Trigger>
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Hint" Value="{x:Null}">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SectionCard}">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SectionCard}">
                    <Border Background="{DynamicResource DT.Brush.Surface}"
                            BorderBrush="{DynamicResource DT.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding HeaderActions}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{TemplateBinding Icon}"
                                                             Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource DT.Brush.Primary}" />
                                    <ContentPresenter Margin="10,0,0,0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      TextBlock.FontSize="15"
                                                      TextBlock.FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:PathBox}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PathBox}">
                    <Border x:Name="Frame"
                            Background="{DynamicResource DT.Brush.Surface}"
                            BorderBrush="{DynamicResource DT.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{TemplateBinding BrowseCommand}"
                                    Cursor="Hand"
                                    Padding="14,0"
                                    Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="0,6,6,0"
                                    Style="{DynamicResource MaterialDesignFlatButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{TemplateBinding BrowseText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Rectangle DockPanel.Dock="Right" Width="1" Fill="{DynamicResource DT.Brush.Border}" />
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FolderOutline"
                                                     Width="18" Height="18" Margin="10,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{TemplateBinding Path}"
                                           ToolTip="{TemplateBinding Path}"
                                           FontFamily="{DynamicResource DT.Font.Mono}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DT.Brush.TextPrimary}" />
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Placeholder}"
                                           FontSize="12"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DT.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="Path" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Path" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SwitchField}">
        <Setter Property="Margin" Value="0,2,0,6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SwitchField}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{TemplateBinding Label}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12"
                                   FontFamily="{DynamicResource DT.Font.Mono}"
                                   Foreground="{DynamicResource DT.Brush.Primary}" />
                        <ToggleButton IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource MaterialDesignSwitchToggleButton}">
                            <ToggleButton.LayoutTransform>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                            </ToggleButton.LayoutTransform>
                        </ToggleButton>
                        <TextBlock x:Name="ValueText"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="12"
                                   FontFamily="{DynamicResource DT.Font.Mono}"
                                   Text="{TemplateBinding OffText}"
                                   Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ValueText" Property="Text" Value="{Binding OnText, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
