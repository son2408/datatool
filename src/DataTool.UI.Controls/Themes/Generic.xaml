<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:local="clr-namespace:DataTool.UI.Controls"
                    xmlns:conv="clr-namespace:DataTool.UI.Controls.Converters">

    <conv:InverseBooleanConverter x:Key="DT.Internal.InverseBool" />
    <conv:HasTextConverter x:Key="DT.Internal.HasText" />

    <Style TargetType="{x:Type local:FormField}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FormField}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{TemplateBinding Label}"
                                       FontSize="12"
                                       FontFamily="{DynamicResource DT.Font.Mono}"
                                       Foreground="{DynamicResource DT.Brush.Primary}" />
                            <TextBlock x:Name="HintText"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       Text="{TemplateBinding Hint}"
                                       Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                        </StackPanel>
                        <TextBox x:Name="PART_TextBox"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 FontFamily="{DynamicResource DT.Font.Mono}"
                                 FontSize="13"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="{TemplateBinding Placeholder}"
                                 materialDesign:HintAssist.IsFloating="False"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}" />
                        <TextBlock x:Name="FooterText"
                                   Margin="2,4,0,0" FontSize="12"
                                   Text="{TemplateBinding Footer}"
                                   Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMultiline" Value="True">
                            <Setter TargetName="PART_TextBox" Property="AcceptsReturn" Value="True" />
                            <Setter TargetName="PART_TextBox" Property="TextWrapping" Value="Wrap" />
                            <Setter TargetName="PART_TextBox" Property="VerticalContentAlignment" Value="Top" />
                            <Setter TargetName="PART_TextBox" Property="Height" Value="96" />
                            <Setter TargetName="PART_TextBox" Property="VerticalScrollBarVisibility" Value="Auto" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="">
                            <Setter TargetName="FooterText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="FooterText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FooterText" Property="Text" Value="{Binding Error, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="FooterText" Property="Foreground" Value="{DynamicResource DT.Brush.Danger}" />
                            <Setter TargetName="PART_TextBox" Property="BorderBrush" Value="{DynamicResource DT.Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="UseMonospace" Value="False">
                            <Setter TargetName="PART_TextBox" Property="FontFamily" Value="{DynamicResource DT.Font.Ui}" />
                        </Trigger>
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Hint" Value="{x:Null}">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SectionCard}">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SectionCard}">
                    <Border Background="{DynamicResource DT.Brush.Surface}"
                            BorderBrush="{DynamicResource DT.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding HeaderActions}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{TemplateBinding Icon}"
                                                             Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource DT.Brush.Primary}" />
                                    <ContentPresenter Margin="10,0,0,0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      TextBlock.FontSize="15"
                                                      TextBlock.FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:PathBox}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PathBox}">
                    <Border x:Name="Frame"
                            Background="{DynamicResource DT.Brush.Surface}"
                            BorderBrush="{DynamicResource DT.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{TemplateBinding BrowseCommand}"
                                    Cursor="Hand"
                                    Padding="14,0"
                                    Height="Auto"
                                    materialDesign:ButtonAssist.CornerRadius="0,6,6,0"
                                    Style="{DynamicResource MaterialDesignFlatButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{TemplateBinding BrowseText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Rectangle DockPanel.Dock="Right" Width="1" Fill="{DynamicResource DT.Brush.Border}" />
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FolderOutline"
                                                     Width="18" Height="18" Margin="10,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{TemplateBinding Path}"
                                           ToolTip="{TemplateBinding Path}"
                                           FontFamily="{DynamicResource DT.Font.Mono}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DT.Brush.TextPrimary}" />
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Placeholder}"
                                           FontSize="12"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DT.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="Path" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Path" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SwitchField}">
        <Setter Property="Margin" Value="0,2,0,6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SwitchField}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{TemplateBinding Label}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12"
                                   FontFamily="{DynamicResource DT.Font.Mono}"
                                   Foreground="{DynamicResource DT.Brush.Primary}" />
                        <ToggleButton IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource MaterialDesignSwitchToggleButton}">
                            <ToggleButton.LayoutTransform>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                            </ToggleButton.LayoutTransform>
                        </ToggleButton>
                        <TextBlock x:Name="ValueText"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="12"
                                   FontFamily="{DynamicResource DT.Font.Mono}"
                                   Text="{TemplateBinding OffText}"
                                   Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ValueText" Property="Text" Value="{Binding OnText, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SearchPicker}">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SearchPicker}">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=PART_Popup, Converter={StaticResource DT.Internal.InverseBool}}"
                                      Focusable="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Frame"
                                            Background="{DynamicResource DT.Brush.Surface}"
                                            BorderBrush="{DynamicResource DT.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6,0,10,0">
                                        <ContentPresenter VerticalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DT.Brush.Primary}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DT.Brush.Primary}" />
                                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Frame" Property="Padding" Value="5,0,9,0" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource DT.Brush.Primary}">
                                    <materialDesign:PackIcon Kind="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                             Width="16" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="White" />
                                </Border>
                                <materialDesign:PackIcon x:Name="Chevron" DockPanel.Dock="Right" Kind="ChevronDown"
                                                         Width="18" Height="18" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                                <StackPanel Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedText, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource DT.Brush.TextPrimary}" />
                                        <TextBlock x:Name="PlaceholderText"
                                                   Text="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="13" Visibility="Collapsed"
                                                   Foreground="{DynamicResource DT.Brush.TextSecondary}" />
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Margin="8,0,8,8"
                                    Width="{Binding DropDownWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource DT.Brush.Surface}"
                                    BorderBrush="{DynamicResource DT.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Direction="270" />
                                </Border.Effect>
                                <DockPanel Margin="8">
                                    <TextBox x:Name="PART_Search"
                                             DockPanel.Dock="Top"
                                             Margin="2,0,2,8"
                                             Cursor="IBeam"
                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{Binding SearchHint, RelativeSource={RelativeSource TemplatedParent}}"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                             materialDesign:TextFieldAssist.HasClearButton="True" />
                                    <Grid>
                                        <ListBox x:Name="PART_List"
                                                 MaxHeight="320"
                                                 ItemsSource="{Binding FilteredView, RelativeSource={RelativeSource TemplatedParent}}"
                                                 DisplayMemberPath="{Binding DisplayMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
                                                 IsSynchronizedWithCurrentItem="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 FontWeight="SemiBold">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Padding" Value="12,8" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <TextBlock x:Name="EmptyResult"
                                                   Margin="8,12" HorizontalAlignment="Center"
                                                   Text="{Binding EmptyText, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{DynamicResource DT.Brush.TextSecondary}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedText" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasResults" Value="False">
                            <Setter TargetName="EmptyResult" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="Kind" Value="ChevronUp" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
